# Opcional: se não definir DATABASE_URL, o backend cai automaticamente
# para um arquivo SQLite local (./backend/painel.db), útil para rodar e
# testar o projeto sem precisar configurar Postgres primeiro.
DATABASE_URL=postgresql://postgres:SUASENHA@localhost:5432/painel_atendimentos

# Chave secreta usada para assinar os tokens de login dos servidores.
# OBRIGATÓRIO trocar por um valor aleatório único em produção — nunca
# use o valor padrão de desenvolvimento. Gere um com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-este-valor-por-uma-chave-aleatoria-em-producao
